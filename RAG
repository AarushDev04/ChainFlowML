# ==============================================================================
# CHAINFLOW AI — app/services/rag.py
# ChromaDB retrieval + ChatQA generation service.
# Reads from R (global state registry) — no model loading here.
# ==============================================================================

from __future__ import annotations

import time
from typing import Dict, List, Optional

import torch

from app.core.config import RAG_COLLECTIONS, DEFAULT_TOP_K, SYSTEM_PROMPT, LLM_MAX_CTX
from app.core import state


def retrieve(query: str, top_k: int = DEFAULT_TOP_K,
             collections: Optional[List[str]] = None) -> List[Dict]:
    R = state.R
    if not R["embedder"] or not R["chroma"]:
        return []

    cols  = collections or RAG_COLLECTIONS
    q_emb = R["embedder"].encode([query], show_progress_bar=False).tolist()
    hits  = []

    for col_name in cols:
        try:
            col = R["chroma"].get_collection(col_name)
            if col.count() == 0:
                continue
            k   = min(top_k, col.count())
            res = col.query(
                query_embeddings=q_emb, n_results=k,
                include=["documents", "metadatas", "distances"],
            )
            for doc, meta, dist in zip(
                res["documents"][0], res["metadatas"][0], res["distances"][0]
            ):
                hits.append({"text": doc, "metadata": meta,
                             "distance": dist, "collection": col_name})
        except Exception:
            pass

    hits.sort(key=lambda x: x["distance"])
    seen, unique = set(), []
    for h in hits:
        k_ = h["text"][:80]
        if k_ not in seen:
            seen.add(k_)
            unique.append(h)
    return unique[:top_k]


def generate(question: str, chunks: List[Dict],
             max_tokens: int = 512) -> tuple[str, float]:
    R = state.R
    if not R["llm"] or not R["tokenizer"]:
        return "LLM not loaded — check server logs.", 0.0

    context = "\n\n".join(
        [f"[{c['collection']}]\n{c['text']}" for c in chunks]
    )
    prompt = (
        f"System: {SYSTEM_PROMPT}\n\n"
        f"Context:\n{context}\n\n"
        f"User: {question}\n\n"
        f"Assistant:"
    )
    inputs    = R["tokenizer"](
        prompt, return_tensors="pt",
        truncation=True, max_length=LLM_MAX_CTX,
    ).to(R["device"])
    input_len = inputs["input_ids"].shape[1]

    t0 = time.time()
    with torch.no_grad():
        out = R["llm"].generate(
            **inputs,
            max_new_tokens=max_tokens,
            temperature=0.1,
            do_sample=False,
            pad_token_id=R["tokenizer"].eos_token_id,
            eos_token_id=R["tokenizer"].eos_token_id,
            repetition_penalty=1.1,
        )
    answer = R["tokenizer"].decode(
        out[0][input_len:], skip_special_tokens=True
    ).strip()
    return answer, round(time.time() - t0, 2)
